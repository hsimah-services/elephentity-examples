{
    "name": "elephentity/example-clog",
    "description": "The Elephentity worked example, as a real WordPress plugin: a lending library for equipment.",
    "type": "wordpress-plugin",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "elephentity/runtime": "^0.8",
        "elephentity/wordpress": "^0.2",
        "elephentity/wpgraphql": "^0.1"
    },
    "require-dev": {
        "elephentity/elephentity": "dev-main",
        "elephentity/codegen": "^0.5",
        "elephentity/codegen-php": "^0.5",
        "elephentity/codegen-wordpress": "^0.3",
        "elephentity/codegen-wpgraphql": "^0.2",
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-stubs/wordpress-stubs": "^6.7 || ^7.0",
        "axepress/wp-graphql-stubs": "^2.22",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Clog\\Entity\\": "generated/",
            "Clog\\": "src/"
        }
    },
    "scripts": {
        "build-generators": "sh ../tools/build-generators",
        "stan": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "eleph-fmt": "eleph fmt",
        "eleph-validate": "eleph validate",
        "eleph-generate": "eleph generate --check",
        "eleph-check": "eleph check",
        "ci": [
            "@style",
            "@stan",
            "@eleph-fmt",
            "@eleph-validate",
            "@eleph-generate",
            "@eleph-check"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
