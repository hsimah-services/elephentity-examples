{
    "name": "elephentity/example-clog",
    "description": "The Elephentity worked example: a household inventory on SQLite and GraphQL.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "elephentity/graphql": "^0.17.0",
        "elephentity/runtime": "^0.17.0",
        "elephentity/sqlite": "^0.17.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0",
        "webonyx/graphql-php": "^15.37"
    },
    "require-dev": {
        "elephentity/codegen": "^0.7.0",
        "elephentity/codegen-graphql-php": "^0.1@alpha",
        "elephentity/codegen-php": "^0.9.0",
        "elephentity/codegen-sqlite": "^0.1@alpha",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Clog\\Entity\\": "generated/",
            "Clog\\Standalone\\": "standalone/src/",
            "Clog\\": "src/"
        }
    },
    "scripts": {
        "build-generators": "sh ../tools/build-generators",
        "stan": "phpstan analyse --memory-limit=1G",
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "eleph-fmt": "eleph fmt",
        "eleph-validate": "eleph validate",
        "eleph-generate": "eleph generate --check",
        "eleph-check": "eleph check",
        "ci": [
            "@style",
            "@stan",
            "@eleph-fmt",
            "@eleph-validate",
            "@eleph-generate",
            "@eleph-check",
            "@test"
        ],
        "test": "@php tests/smoke.php"
    },
    "config": {
        "platform": {
            "php": "8.3.31"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
