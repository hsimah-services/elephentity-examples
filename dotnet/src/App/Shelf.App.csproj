<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Shelf.App</RootNamespace>
    <AssemblyName>Shelf.App</AssemblyName>
    <!-- The generated trees are signed and committed; they are compiled in, never edited. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Generated/**/*.cs" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Cosmos/Elephentity.Cosmos.csproj" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.GraphQL/Elephentity.GraphQL.csproj" />
    <ProjectReference Include="$(ElephentityDotnet)/src/Elephentity.Tsquid/Elephentity.Tsquid.csproj" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
