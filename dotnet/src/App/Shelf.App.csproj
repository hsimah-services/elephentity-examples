<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Shelf.App</RootNamespace>
    <AssemblyName>Shelf.App</AssemblyName>
    <!-- The generated trees are signed and committed; they are compiled in, never edited. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Generated/**/*.cs" />
    <PackageReference Include="Elephentity.Cosmos" Version="0.1.0-alpha.1" />
    <PackageReference Include="Elephentity.GraphQL" Version="0.1.0-alpha.1" />
    <PackageReference Include="Elephentity.Tsquid" Version="0.1.0-alpha.1" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
